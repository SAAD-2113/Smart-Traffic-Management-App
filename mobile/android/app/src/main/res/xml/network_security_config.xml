<?xml version="1.0" encoding="utf-8"?>
<!--
  PROTOTYPE SETTING. Plain HTTP is allowed so the app can reach a development backend on the
  local network (e.g. http://192.168.1.20:8000), which has no TLS certificate. The app warns
  in its server settings whenever a non-HTTPS address is used. A deployment must use HTTPS
  (for example through a Cloudflare Tunnel) and set cleartextTrafficPermitted to false.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
