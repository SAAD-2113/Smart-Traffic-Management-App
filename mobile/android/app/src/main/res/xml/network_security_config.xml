<?xml version="1.0" encoding="utf-8"?>
<!--
  PROTOTYPE SETTING. Plain (cleartext) traffic is allowed for two local cases:
  - Software mode: a development backend on the local network (e.g. http://192.168.1.20:8000),
    which has no TLS certificate. The app warns whenever a non-HTTPS server address is used.
  - Hardware mode: the ESP32 controller's WebSocket, ws://192.168.4.1:81/ by default. Its
    address is editable, so it cannot be limited to one domain entry here.
  A deployment that only talks to a cloud server should use HTTPS and limit cleartext to the
  controller's address with a <domain-config>.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
