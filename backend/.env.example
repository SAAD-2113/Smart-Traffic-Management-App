# Copy to backend/.env and fill in. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Must match infra/.env. URL-encode special characters in the password (@ -> %40, # -> %23).
DATABASE_URL=postgresql+asyncpg://traffic:CHANGE_ME@localhost:5432/smart_traffic

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=2592000
PASSWORD_RESET_TTL_S=1800

# JSON list of allowed browser origins (the Flutter web dashboard).
CORS_ORIGINS=["http://localhost:8080"]
RATE_LIMIT_ENABLED=true
DEMO_MODE=false
MAX_VEHICLES_PER_USER=3

# In development, reset links are printed to the backend console instead of emailed.
PASSWORD_RESET_URL=http://localhost:8080/reset-password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=you@gmail.com
