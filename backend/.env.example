# Copy to backend/.env and fill in. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Must match infra/.env. URL-encode special characters in the password (@ -> %40, # -> %23).
DATABASE_URL=postgresql+asyncpg://traffic:CHANGE_ME@localhost:5432/smart_traffic

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=2592000
PASSWORD_RESET_TTL_S=1800

# JSON list of allowed browser origins (the Flutter web dashboard).
CORS_ORIGINS=["http://localhost:8080"]
RATE_LIMIT_ENABLED=true
MAX_VEHICLES_PER_USER=3

# Demo simulation: lets a manager start a simulated fleet from the app. Never in production.
DEMO_MODE=false

# Traffic engine (defaults shown). Telemetry rules are documented in docs/ARCHITECTURE.md.
TRAFFIC_ENGINE_ENABLED=true
TRAFFIC_CYCLE_S=2
METRICS_PERSIST_INTERVAL_S=30
LIVE_WINDOW_S=15
BACKFILL_MAX_AGE_S=600
USABLE_ACCURACY_M=50
TELEMETRY_RETENTION_DAYS=30
SIMULATED_TELEMETRY_RETENTION_HOURS=1
EMERGENCY_STALE_S=120
EMERGENCY_MAX_DURATION_S=3600

# Fixed-time / adaptive switching for intersections with the AUTO policy (defaults shown).
# Congestion is averaged over CONTROL_WINDOW_S. Adaptive starts when the average is at least
# CONTROL_ENTER_LEVEL with at least CONTROL_MIN_VEHICLES vehicles for CONTROL_ENTER_HOLD_S. It ends
# when the average is at most CONTROL_EXIT_LEVEL for CONTROL_EXIT_HOLD_S, and only after
# CONTROL_MIN_ADAPTIVE_S. Below CONTROL_MIN_DATA_QUALITY the fixed-time plan is used.
# See docs/ARCHITECTURE.md, "Signal-control modes".
CONTROL_ENTER_LEVEL=HIGH
CONTROL_EXIT_LEVEL=LOW
CONTROL_WINDOW_S=60
CONTROL_ENTER_HOLD_S=20
CONTROL_EXIT_HOLD_S=60
CONTROL_MIN_ADAPTIVE_S=120
CONTROL_MIN_DATA_QUALITY=MEDIUM
CONTROL_MIN_VEHICLES=8

# Hosted deployments (docs/DEPLOY_CLOUD.md): created on start-up if missing, never changed afterwards.
# BOOTSTRAP_ADMIN_EMAIL=manager@example.com
# BOOTSTRAP_ADMIN_PASSWORD=
# SEED_CORRIDOR=auto        # auto (fixed-time until congested, then adaptive) or fixed

# In development, reset links are printed to the backend console instead of emailed.
PASSWORD_RESET_URL=http://localhost:8080/reset-password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=you@gmail.com
